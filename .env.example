# Copy to .env (docker compose reads it automatically) and fill in every value.
# docker compose refuses to start while a required value is missing.

# Postgres credentials used by the database container and every microservice.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Signing key shared by api-gateway and user-service (base64, >= 256 bits). Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Grafana "admin" user password.
GRAFANA_ADMIN_PASSWORD=change-me

# Comma-separated list of origins allowed by the API gateway CORS config.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
