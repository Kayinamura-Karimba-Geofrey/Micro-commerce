# Copy to .env (docker compose reads it automatically) and adjust before deploying.

# Postgres credentials used by the database container and every microservice.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Signing key shared by api-gateway and user-service. Generate a strong value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437

# Comma-separated list of origins allowed by the API gateway CORS config.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
